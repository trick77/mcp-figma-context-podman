# Runtime + build-time config for figma-context-mcp. Copy to .env and edit.
# .env is gitignored. Set perms to 600 manually since it holds a secret:
#   chmod 600 .env

# --- REQUIRED at runtime: Figma Personal Access Token ---
#
# Create at https://www.figma.com/developers/api#access-tokens.
# Grant ONLY read scopes:
#   - File content:    Read-only
#   - Variables:       Read-only
#   - Dev resources:   Read-only (optional)
#   - Library content: Read-only (optional)
# Do NOT grant any "Write" scopes. The upstream MCP exposes a
# `download_figma_images` tool that writes image files to the named volume
# mounted at /home/node/images — that's the only writable surface.
#
# Read by podman-compose via env_file=. Never bake into the image.
#
# ROTATION: Figma PATs expire after 90 days max. To rotate, replace the value
# below and restart the container:
#   podman-compose restart
FIGMA_API_KEY=figd_replace-me

# Optional: OAuth Bearer token instead of a PAT (one or the other, not both).
#FIGMA_OAUTH_TOKEN=

# --- Telemetry ---
# Upstream ships PostHog telemetry on by default. The image already sets
# FRAMELINK_TELEMETRY=false and DO_NOT_TRACK=1; repeated here for transparency
# and so a per-host override is one edit away.
FRAMELINK_TELEMETRY=false
DO_NOT_TRACK=1

# Output format from MCP tools: yaml (default) or json.
#OUTPUT_FORMAT=yaml

# --- Build-time overrides (consumed by scripts/build.sh) ---

# npm registry override (e.g. corporate mirror).
#NPM_REGISTRY=https://registry.npmjs.org/

# Pin a specific upstream npm version. Bare semver, NO leading 'v' (this is
# the npm package version, not the git tag).
# Releases: https://www.npmjs.com/package/figma-developer-mcp?activeTab=versions
VERSION=0.11.0

# --- Optional outbound HTTP proxy ---
# upstream respects HTTPS_PROXY/HTTP_PROXY/NO_PROXY via undici's
# EnvHttpProxyAgent. Use FIGMA_PROXY for an explicit override that bypasses
# env-var detection (or set it to 'none' to force a direct connection).
#HTTPS_PROXY=
#HTTP_PROXY=
#NO_PROXY=
#FIGMA_PROXY=
