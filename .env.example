# Runtime config for figma-context-mcp. Copy to .env and edit.
# .env is gitignored. Set perms to 600 manually since it holds a secret:
#   chmod 600 .env

# --- REQUIRED: Figma Personal Access Token ---
#
# Create at https://www.figma.com/developers/api#access-tokens.
# Grant ONLY read scopes:
#   - File content:    Read-only
#   - Variables:       Read-only
#   - Dev resources:   Read-only (optional)
#   - Library content: Read-only (optional)
# Do NOT grant any "Write" scopes. The upstream MCP exposes a
# `download_figma_images` tool that writes image files to IMAGES_HOST_DIR
# on the host (see below). That's the only writable surface besides /tmp.
#
# ROTATION: Figma PATs expire after 90 days max. To rotate, replace the value
# below and `podman-compose restart`.
FIGMA_API_KEY=figd_replace-me

# --- Optional knobs ---

# Override the bind-mount source for `download_figma_images`. Defaults to
# /var/tmp/figma-context-mcp (works for rootless podman on Linux: sticky
# world-writable dir, persists across reboots). Set this to land files
# elsewhere — must be a LITERAL absolute path (podman-compose can't
# expand $HOME or other vars inside its own defaults, but it WILL expand
# this value if you set it explicitly here). Examples:
#   IMAGES_HOST_DIR=/home/youruser/.cache/figma-context-mcp
#   IMAGES_HOST_DIR=/abs/path/to/your-project/assets
# The ':U' mount flag chowns this dir recursively to the mapped container
# UID on each `up`. Use an empty/dedicated dir, never a shared one with
# files whose ownership you rely on. Restart the container after changing.
#IMAGES_HOST_DIR=

# OAuth Bearer token instead of a PAT (one or the other, not both).
#FIGMA_OAUTH_TOKEN=

# Output format from MCP tools: yaml (default) or json.
#OUTPUT_FORMAT=yaml

# Outbound HTTP proxy for api.figma.com. Upstream respects standard
# HTTPS_PROXY/HTTP_PROXY/NO_PROXY via undici's EnvHttpProxyAgent. Use
# FIGMA_PROXY for an explicit override that bypasses env-var detection
# (or set it to 'none' to force a direct connection).
#HTTPS_PROXY=
#HTTP_PROXY=
#NO_PROXY=
#FIGMA_PROXY=

# Override the image-baked telemetry-off defaults (FRAMELINK_TELEMETRY=false,
# DO_NOT_TRACK=1). Only set if you want telemetry back on.
#FRAMELINK_TELEMETRY=true
#DO_NOT_TRACK=
